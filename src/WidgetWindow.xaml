<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Holiday Timer" Width="344" Height="344" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Foreground="{DynamicResource BodyText}">
  <Viewbox x:Name="WidgetView" Stretch="Uniform" StretchDirection="Both">
    <Grid x:Name="GadgetHoverArea" Width="344" Height="344">
      <Ellipse Width="344" Height="344" Fill="{DynamicResource OrbSoftGlow}" IsHitTestVisible="False"/>
      <Grid x:Name="OrbMaterial" Opacity="{DynamicResource OrbMaterialOpacity}" OpacityMask="{DynamicResource OrbMaterialMask}" IsHitTestVisible="False">
        <Border x:Name="WidgetSurface" Background="{DynamicResource WidgetSurface}" Width="344" Height="344" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="172"/>
        <Ellipse Width="268" Height="236" Fill="{DynamicResource CountdownScrim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <Canvas x:Name="OrbCanvas" Width="344" Height="344" IsHitTestVisible="False"/>
      <Ellipse Width="266" Height="266" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border x:Name="ActionHoverBridge" Width="300" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,29" Background="Transparent" IsHitTestVisible="False"/>
      <Border x:Name="DragArea" Background="Transparent" Margin="39,39,39,51" CornerRadius="133" Cursor="SizeAll" ToolTip="Drag to move the countdown">
        <StackPanel Margin="20,0,20,0" VerticalAlignment="Center" Effect="{DynamicResource OrbTextShadowEffect}">
          <TextBlock x:Name="HolidayLabel" Text="My holiday" FontSize="14" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OrbText}" Margin="0,0,0,9"/>
          <TextBlock x:Name="RemainingNumber" Text="30" FontFamily="{DynamicResource CountdownFont}" FontWeight="SemiBold" FontSize="64" Foreground="{DynamicResource OrbText}" TextAlignment="Center" Typography.NumeralAlignment="Tabular" Height="84" VerticalAlignment="Center" LineHeight="84" LineStackingStrategy="BlockLineHeight"/>
          <TextBlock x:Name="RemainingUnit" Text="days to go" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource OrbSecondaryText}" TextAlignment="Center" Margin="0,2,0,0"/>
          <TextBlock x:Name="TargetLabel" Text="13 Nov 2026 · 09:00" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource OrbMutedText}" TextAlignment="Center" Margin="0,13,0,0"/>
        </StackPanel>
      </Border>
      <Border x:Name="ActionStrip" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,7" Background="{DynamicResource UtilitySurface}" CornerRadius="18" Padding="5,1" BorderBrush="{DynamicResource Line}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal"><Button x:Name="UnitButton" Content="Days" Background="Transparent" BorderThickness="0" Padding="8,7" FontSize="11" ToolTip="Switch countdown unit" AutomationProperties.Name="Switch countdown unit"/><Button x:Name="WorkdayButton" Content="Workdays" Width="104" Background="Transparent" BorderThickness="0" Padding="8,7" FontSize="11" ToolTip="Switch workday counting on or off" AutomationProperties.Name="Toggle workday counting"/><Button x:Name="EditButton" Content="Edit" Background="Transparent" BorderThickness="0" Padding="8,7" FontSize="11" AutomationProperties.Name="Edit holiday and preferences"/><Button x:Name="HideButton" Content="Hide" Background="Transparent" BorderThickness="0" Padding="8,7" FontSize="11" ToolTip="Hide in the system tray" AutomationProperties.Name="Hide countdown in the system tray"/></StackPanel>
      </Border>
    </Grid>
  </Viewbox>
</Window>
